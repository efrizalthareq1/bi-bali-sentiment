# Environment variables — copy values into backend/.env and frontend/.env.local

# === Backend (backend/.env) ===
DATABASE_URL=sqlite:///./data/sentiment.db
# DATABASE_URL=postgresql://user:password@localhost:5432/bi_bali_sentiment

LLM_PROVIDER=none
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

CORS_ORIGINS=http://localhost:3000
ENABLE_SCHEDULER=true
NEWS_SYNC_INTERVAL_MINUTES=60
ANALYZE_INTERVAL_MINUTES=5

X_BEARER_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
INSTAGRAM_HASHTAG_SYNC_LIMIT=15
INSTAGRAM_MONITOR_USERNAME=qrissummerrun
INSTAGRAM_SESSION_ID=
INSTAGRAM_CSRF_TOKEN=
INSTAGRAM_DS_USER_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_LOOKBACK_DAYS=30

# Outlook / Microsoft Graph Mail
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_MAILBOX=
OUTLOOK_FOLDER=inbox
OUTLOOK_LOOKBACK_DAYS=30
# Optional alternative to client credentials:
OUTLOOK_ACCESS_TOKEN=

# === Frontend (frontend/.env.local) ===
NEXT_PUBLIC_API_URL=http://localhost:8000
